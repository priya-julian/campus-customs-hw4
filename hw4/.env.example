# Copy this file to the AI Foundations project root as `.env` and fill in your own key.
# Never commit the real .env — it is listed in .gitignore.

# Routes the shop agent's OpenAI calls through Portkey.
# Get this from your Portkey dashboard.
PORTKEY_API_KEY=pk-your-portkey-key-here

# Optional. Defaults to https://api.portkey.ai/v1 when unset.
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Optional. Signs session tokens for sign-in. When unset, the backend generates a random
# key on first run and caches it in backend/.session_secret, which is gitignored.
SESSION_SECRET=replace-with-a-long-random-string
